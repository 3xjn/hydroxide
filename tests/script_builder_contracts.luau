local ScriptBuilder = require("../modules/ScriptBuilder")
local fs = require("@lune/fs")

local forkUrl = "https://github.com/green-hat/Hydroxide"

local emptyRemoteCall = ScriptBuilder.RemoteCall({
    SourceRepositoryUrl = forkUrl,
    RemotePath = "game.ReplicatedStorage.Remotes.Purchase",
    Method = "FireServer",
})
assert(
    emptyRemoteCall
        == "-- Generated by Hydroxide's RemoteSpy: https://github.com/green-hat/Hydroxide\n\n"
            .. "game.ReplicatedStorage.Remotes.Purchase:FireServer()",
    "RemoteSpy must produce a complete zero-argument call attributed to the configured fork"
)

local remoteCall = ScriptBuilder.RemoteCall({
    SourceRepositoryUrl = forkUrl,
    RemotePath = "game.ReplicatedStorage.Remotes.Damage",
    Method = "InvokeServer",
    Arguments = {
        { TypeName = "Instance", Value = "workspace.Target" },
        { TypeName = "Number", Value = "250" },
    },
})
assert(
    remoteCall
        == "-- Generated by Hydroxide's RemoteSpy: https://github.com/green-hat/Hydroxide\n\n"
            .. "local ohInstance1 = workspace.Target\n"
            .. "local ohNumber2 = 250\n\n"
            .. "game.ReplicatedStorage.Remotes.Damage:InvokeServer(ohInstance1, ohNumber2)",
    "RemoteSpy must preserve readable OH-prefixed arguments and their call order"
)
assert(loadstring(remoteCall), "RemoteSpy must emit syntactically valid Luau")

local upvalueMutation = ScriptBuilder.UpvalueMutation({
    SourceRepositoryUrl = forkUrl,
    SourceBaseUrl = "https://raw.githubusercontent.com/green-hat/Hydroxide/dev/",
    ScriptPath = "game.Players.LocalPlayer.PlayerScripts.Controller",
    ClosureName = "applyDamage",
    UpvalueIndex = 3,
    ClosureConstants = "{[1] = \"damage\"}",
    ElementIndex = "\"criticalMultiplier\"",
})
assert(
    upvalueMutation
        == "-- Generated by Hydroxide's Upvalue Scanner: https://github.com/green-hat/Hydroxide\n\n"
            .. "local Helpers = loadstring(game:HttpGetAsync(\"https://raw.githubusercontent.com/green-hat/Hydroxide/dev/modules/Helpers.lua\"), \"modules/Helpers.lua\")()\n"
            .. "local oh = Helpers.load({\n"
            .. "    sourceBaseUrl = \"https://raw.githubusercontent.com/green-hat/Hydroxide/dev/\",\n"
            .. "    modules = { \"closure\" },\n"
            .. "    constants = {\n"
            .. "        sourceMode = \"web\",\n"
            .. "        sourceRepositoryUrl = \"https://github.com/green-hat/Hydroxide\",\n"
            .. "    },\n"
            .. "})\n\n"
            .. "local closureTools = oh.closure\n"
            .. "local scriptPath = game.Players.LocalPlayer.PlayerScripts.Controller\n"
            .. "local closureName = \"applyDamage\"\n"
            .. "local upvalueIndex = 3\n"
            .. "local closureConstants = {[1] = \"damage\"}\n\n"
            .. "local closure = closureTools.searchClosure(scriptPath, closureName, upvalueIndex, closureConstants)\n"
            .. "local value = YOUR_NEW_VALUE_HERE\n"
            .. "local elementIndex = \"criticalMultiplier\"\n\n\n"
            .. "-- DO NOT RELY ON THIS FEATURE TO PRODUCE 100% FUNCTIONAL SCRIPTS\n"
            .. "debug.getupvalue(closure, upvalueIndex)[elementIndex] = value",
    "Upvalue Scanner must produce a runnable fork-aware table mutation payload"
)
assert(loadstring(upvalueMutation), "Upvalue Scanner must emit syntactically valid Luau")

local scalarMutation = ScriptBuilder.UpvalueMutation({
    SourceRepositoryUrl = forkUrl,
    SourceBaseUrl = "https://raw.githubusercontent.com/green-hat/Hydroxide/master/",
    ScriptPath = "nil",
    ClosureName = "setSpeed",
    UpvalueIndex = 1,
    ClosureConstants = "{}",
})
local scalarMutationStatement = "debug.setupvalue(closure, upvalueIndex, value)"
assert(
    scalarMutation:sub(-#scalarMutationStatement) == scalarMutationStatement,
    "Scalar upvalues must use debug.setupvalue"
)

local localMutation = ScriptBuilder.UpvalueMutation({
    SourceRepositoryUrl = forkUrl,
    SourceBaseUrl = "https://raw.githubusercontent.com/green-hat/Hydroxide/dev/",
    LocalRoot = "hydroxide/local",
    ScriptPath = "game.Players.LocalPlayer.PlayerScripts.Controller",
    ClosureName = "setSpeed",
    UpvalueIndex = 1,
    ClosureConstants = "{}",
})
assert(
    localMutation:find(
        'local Helpers = loadstring(readfile("hydroxide/local/modules/Helpers.lua"), "modules/Helpers.lua")()',
        1,
        true
    ),
    "Local Hydroxide must generate a helper loader for the uncommitted Volt workspace"
)
assert(
    not localMutation:find("game:HttpGetAsync", 1, true),
    "Local generated scripts must not fetch a stale helper from the configured branch"
)
assert(
    localMutation:find('localRoot = "hydroxide/local"', 1, true)
        and localMutation:find('sourceMode = "local"', 1, true)
        and localMutation:find("local closureTools = oh.closure", 1, true),
    "Local generated scripts must expose the same lowercase consumer interface"
)
assert(loadstring(localMutation), "Local Upvalue Scanner output must remain syntactically valid Luau")

readfile = fs.readFile
local localLoader = ScriptBuilder.HelperLoader({
    SourceRepositoryUrl = forkUrl,
    SourceBaseUrl = "https://raw.githubusercontent.com/green-hat/Hydroxide/dev/",
    LocalRoot = ".",
}, { "closure" })
local loadedLocalOh = assert(loadstring(localLoader .. "return oh"))()
assert(loadedLocalOh.constants.sourceMode == "local", "The generated local loader must create a local oh bundle")
assert(
    type(loadedLocalOh.closure.searchClosure) == "function",
    "The generated local loader must execute and expose the closure module"
)

game = {
    HttpGetAsync = function(_game, url)
        local relativePath = url:match("/Hydroxide/dev/(.+)$")
        assert(relativePath, "The generated web loader must use the configured fork and branch")
        return fs.readFile(relativePath)
    end,
}
local webLoader = ScriptBuilder.HelperLoader({
    SourceRepositoryUrl = forkUrl,
    SourceBaseUrl = "https://raw.githubusercontent.com/green-hat/Hydroxide/dev/",
}, { "closure" })
local loadedWebOh = assert(loadstring(webLoader .. "return oh"))()
assert(loadedWebOh.constants.sourceMode == "web", "The generated web loader must create a web oh bundle")
assert(
    type(loadedWebOh.closure.searchClosure) == "function",
    "The generated web loader must download and expose the closure module"
)

print("script-builder-contracts-ok")
