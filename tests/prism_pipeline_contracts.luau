local fs = require("@lune/fs")

local indexSource = fs.readFile("ui/src/index.tsx")
local islandSource = fs.readFile("ui/src/HydroxideIsland.tsx")
local querySource = fs.readFile("ui/src/QueryBar.tsx")
local filterSource = fs.readFile("ui/src/FilterPopover.tsx")
local listSource = fs.readFile("ui/src/ResultList.tsx")
local windowSource = fs.readFile("ui/window.lua")
local runtimeSource = fs.readFile("ui/runtime.lua")
local prismSource = fs.readFile("ui/prism.lua")
local queryBarSource = fs.readFile("ui/controls/QueryBar.lua")
local filterControlSource = fs.readFile("ui/controls/FilterPopover.lua")
local listControlSource = fs.readFile("ui/controls/List.lua")
local checkSource = fs.readFile("scripts/check.sh")
local gitignore = fs.readFile(".gitignore")
local packageSource = fs.readFile("ui/package.json")
local tsconfig = fs.readFile("ui/tsconfig.json")
local projectSource = fs.readFile("ui/default.project.json")
local explorerSource = fs.readFile("ui/modules/Explorer.lua")
local mainSource = fs.readFile("ui/main.lua")
local lockSource = fs.readFile("ui/package-lock.json")

assert(indexSource:find("export function mountHydroxide", 1, true), "Prism entry must export mountHydroxide(parent, model)")
assert(islandSource:find("theme={HYDROXIDE_THEME}", 1, true), "Islands must use the Hydroxide Prism theme")
assert(islandSource:find('density="compact"', 1, true), "Islands must use compact density")
assert(islandSource:find("<Window", 1, true), "The island entry must mount Prism Window")
assert(islandSource:find('from "@3xjn/prism"', 1, true), "Islands must import from @3xjn/prism")
assert(islandSource:find("kind === \"window\"", 1, true), "mountHydroxide must accept a window kind")
assert(not islandSource:find("480", 1, true), "Hydroxide must not keep Prism's 480 default width")
assert(not islandSource:find("TODO(prism-window)", 1, true), "Prism Window is now the chrome; do not leave the swap TODO")
assert(windowSource:find("Fallback chrome", 1, true), "window.lua must remain a GitHub-loadstring fallback when the dist blob is absent")
assert(not windowSource:find("TODO(prism-window)", 1, true), "window.lua is fallback chrome, not the Prism Window host")
assert(querySource:find("<Input", 1, true), "QueryBar must render Prism Input")
assert(querySource:find("<Button", 1, true), "QueryBar must render a Prism Button")
assert(filterSource:find("<Popover", 1, true), "FilterPopover must render Prism Popover")
assert(filterSource:find("<Stack", 1, true) or filterSource:find("<Menu", 1, true), "FilterPopover must use a Stack or Menu")
assert(filterSource:find('triggerMode="click"', 1, true), "FilterPopover must use click-mode Popover")
assert(filterSource:find("closeOnOutsidePress", 1, true), "FilterPopover must close on outside press")
assert(listSource:find("<ScrollArea", 1, true), "Lists must render Prism ScrollArea")
assert(listSource:find("<Stack", 1, true) or listSource:find("<Pressable", 1, true), "Lists must render Stack or Pressable rows")
assert(not islandSource:find("function AppShell", 1, true), "Do not invent a Hydroxide AppShell")
assert(not islandSource:find("HydroxideAppShell", 1, true), "Do not invent a Hydroxide AppShell")
assert(not islandSource:find("<Draggable", 1, true), "Do not compose Draggable+Box chrome")
assert(not islandSource:find("from \"@prism/components/Draggable\"", 1, true), "Do not compose Draggable+Box chrome")
assert(not querySource:find("gethui", 1, true), "Prism islands must not call gethui")
assert(not indexSource:find("gethui", 1, true), "The mount entry must not call gethui")
assert(not fs.isFile("scripts/build_menu.cjs"), "Do not copy the hub Wax builder")
assert(not fs.isFile("ui/src/prismCompat.tsx"), "Do not shim Prism through a Hydroxide compat barrel")
assert(not fs.isFile("ui/tsconfig.prism.json"), "Do not generate a second tsconfig that copies Prism src")
assert(not fs.isFile("scripts/build_prism_dep.cjs"), "Do not clone Prism into a .prism link; install @3xjn/prism")
assert(packageSource:find('"build": "rbxtsc"', 1, true), "ui npm build must be rbxtsc")
assert(not packageSource:find('"prebuild"', 1, true), "rbxtsc must compile against the installed @3xjn/prism package")
assert(not packageSource:find("wax_ui", 1, true), "Do not keep a Wax Lua patcher in the UI package")
assert(not packageSource:find('"bundle"', 1, true), "Do not ship an executor bundle script")
assert(
	packageSource:find('"@3xjn/prism": "github:3xjn/prism"', 1, true) or packageSource:find('"@3xjn/prism": "file:../prism"', 1, true),
	"Prism must be @3xjn/prism (github:3xjn/prism or file:../prism)"
)
assert(
	lockSource:find("7dd7cc4688d3d7930cad93ce75d4e00b488d8f8c", 1, true),
	"Lockfile must pin Prism master that includes Window collapse-into-chip"
)
assert(not packageSource:find('"prism":', 1, true), "Do not depend on unscoped prism")
assert(not packageSource:find("@rbxts/prism-kit", 1, true), "Do not depend on @rbxts/prism-kit")
assert(not packageSource:find('"name": "prism"', 1, true), "Do not use package name prism")
assert(islandSource:find('from "@3xjn/prism"', 1, true), "Islands must import from @3xjn/prism")
assert(querySource:find('from "@3xjn/prism"', 1, true), "QueryBar must import from @3xjn/prism")
assert(filterSource:find('from "@3xjn/prism"', 1, true), "FilterPopover must import from @3xjn/prism")
assert(listSource:find('from "@3xjn/prism"', 1, true), "Lists must import from @3xjn/prism")
assert(tsconfig:find('"outDir": "out"', 1, true), "rbxtsc must emit ui/out")
assert(tsconfig:find("node_modules/@3xjn", 1, true), "tsconfig typeRoots must include node_modules/@3xjn")
assert(tsconfig:find("node_modules/@rbxts", 1, true), "tsconfig typeRoots must keep node_modules/@rbxts")
assert(not tsconfig:find("node_modules/prism/", 1, true), "Do not resolve unscoped node_modules/prism")
assert(not tsconfig:find(".prism/out/lib", 1, true), "Do not compile against a .prism checkout link")
assert(not tsconfig:find("@rbxts/prism-kit", 1, true), "Do not resolve @rbxts/prism-kit")
assert(not tsconfig:find(".generated/prism-src", 1, true), "Do not copy Prism src into .generated")
assert(not tsconfig:find("C:/git/prism", 1, true), "Do not hardcode a Prism checkout path")
assert(projectSource:find('"$path": "out"', 1, true), "Rojo must mount the rbxtsc ui/out artifact")
assert(projectSource:find('"$path": "node_modules/@rbxts"', 1, true), "Rojo must keep @rbxts next to other scopes")
assert(projectSource:find('"$path": "node_modules/@3xjn"', 1, true), "Rojo must include node_modules/@3xjn next to @rbxts")
assert(not projectSource:find(".prism/out/lib", 1, true), "Rojo must not mount a .prism checkout")
assert(not fs.isFile("scripts/wax_ui.cjs"), "Do not keep a Wax Lua patcher")
assert(gitignore:find("ui/node_modules/", 1, true), "UI node_modules must stay out of git")
assert(gitignore:find("ui/out/", 1, true), "rbxtsc emit must stay out of git")
assert(gitignore:find("ui/dist/", 1, true), "Optional executor blobs must stay out of git")
assert(not gitignore:find("ui/.prism", 1, true), "Do not keep a .prism package-link workaround")
assert(not fs.isDir("ui/.generated/prism-src"), "Generated Prism copies must not be vendored")
assert(prismSource:find("mountHydroxide", 1, true), "Runtime must call mountHydroxide")
assert(prismSource:find('pcall(import, "ui/dist/Hydroxide")', 1, true), "Prism must probe the optional executor blob through import()")
assert(prismSource:find("function Prism.available", 1, true), "Prism.mount must be gated behind a successful artifact load")
assert(not prismSource:find('import("ui/out', 1, true), "Do not HttpGet rbxtsc emit as a Roblox DataModel")
assert(not prismSource:find("ui/out/", 1, true), "Do not treat rbxtsc emit as an executor module")
assert(queryBarSource:find('kind = "queryBar"', 1, true), "QueryBar.lua must mount a Prism query island")
assert(queryBarSource:find("Prism.available()", 1, true), "QueryBar must not mount Prism when the artifact is missing")
assert(queryBarSource:find('create("TextBox"', 1, true), "QueryBar must keep a Luau TextBox fallback")
assert(filterControlSource:find("QueryBar.new", 1, true), "FilterPopover.lua must reuse the Prism query island")
assert(filterControlSource:find("ShowGame", 1, true), "FilterPopover must keep the Luau scanner-filter options")
assert(listControlSource:find('kind = "list"', 1, true), "List.lua must mount a Prism list island")
assert(listControlSource:find("Prism.available()", 1, true), "List must not mount Prism when the artifact is missing")
assert(listControlSource:find("ScrollingFrame", 1, true), "List must keep a Luau ScrollingFrame fallback")
assert(runtimeSource:find('query:SetAttribute("Placeholder"', 1, true), "Runtime query bars must be empty Prism hosts")
assert(not runtimeSource:find('create("TextBox", "Search"', 1, true), "Runtime must not hand-build query TextBoxes")
assert(not runtimeSource:find('create("ScrollingFrame", "Content"', 1, true), "Runtime must not hand-build list ScrollingFrames")
assert(checkSource:find("*_contracts.luau", 1, true), "check.sh must run contracts with a glob")
assert(not checkSource:find("sha256sum", 1, true), "check.sh must not curl-hash Roblox types")
assert(checkSource:find("types/roblox.d.luau", 1, true), "check.sh must use the pinned Roblox types path")
assert(explorerSource:find("return Explorer", 1, true), "Explorer must stay stubbed")
assert(not explorerSource:find("List.new", 1, true), "Explorer must not grow a page in this pass")
assert(mainSource:find("ScriptGraph = import(\"modules/ScriptGraph\")", 1, true), "ScriptGraph methods must stay on oh.Api")
assert(mainSource:find("Prism.available()", 1, true), "Prism Window must mount only when the executor blob is present")
assert(mainSource:find('kind = "window"', 1, true), "Hydroxide must consume Prism Window through mountHydroxide")
assert(mainSource:find("onClose", 1, true), "Hydroxide must pass onClose so Window can still exit")
assert(mainSource:find('import("ui/window")', 1, true), "The Luau window fallback must remain for GitHub loadstring without a dist blob")
assert(mainSource:find("DefaultWindowSize", 1, true), "Hydroxide must pass its own window size, not Prism's 480×360 default")
assert(not fs.isFile("ui/dist/Hydroxide.provenance"), "Do not keep a Wax provenance writer")
assert(not fs.isDir("ui/.generated/prism"), "Prism source must not be vendored as a permanent tree")

print("prism-pipeline-contracts-ok")
