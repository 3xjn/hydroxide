local fs = require("@lune/fs")

local indexSource = fs.readFile("ui/src/index.tsx")
local islandSource = fs.readFile("ui/src/HydroxideIsland.tsx")
local querySource = fs.readFile("ui/src/QueryBar.tsx")
local filterSource = fs.readFile("ui/src/FilterPopover.tsx")
local listSource = fs.readFile("ui/src/ResultList.tsx")
local windowSource = fs.readFile("ui/window.lua")
local runtimeSource = fs.readFile("ui/runtime.lua")
local prismSource = fs.readFile("ui/prism.lua")
local queryBarSource = fs.readFile("ui/controls/QueryBar.lua")
local filterControlSource = fs.readFile("ui/controls/FilterPopover.lua")
local listControlSource = fs.readFile("ui/controls/List.lua")
local checkSource = fs.readFile("scripts/check.sh")
local gitignore = fs.readFile(".gitignore")
local packageSource = fs.readFile("ui/package.json")
local tsconfig = fs.readFile("ui/tsconfig.json")
local projectSource = fs.readFile("ui/default.project.json")
local waxSource = fs.readFile("scripts/wax_ui.cjs")
local buildUiSource = fs.readFile("scripts/build_ui.sh")
local explorerSource = fs.readFile("ui/modules/Explorer.lua")
local mainSource = fs.readFile("ui/main.lua")

assert(indexSource:find("export function mountHydroxide", 1, true), "Prism entry must export mountHydroxide(parent, model)")
assert(islandSource:find('theme={DEFAULT_DARK_THEME}', 1, true), "Islands must use Prism DEFAULT_DARK_THEME")
assert(islandSource:find('density="compact"', 1, true), "Islands must use compact density")
assert(querySource:find("<Input", 1, true), "QueryBar must render Prism Input")
assert(querySource:find("<Button", 1, true), "QueryBar must render a Prism Button")
assert(filterSource:find("<Popover", 1, true), "FilterPopover must render Prism Popover")
assert(filterSource:find("<Stack", 1, true) or filterSource:find("<Menu", 1, true), "FilterPopover must use a Stack or Menu")
assert(filterSource:find('triggerMode="click"', 1, true), "FilterPopover must use click-mode Popover")
assert(filterSource:find("closeOnOutsidePress", 1, true), "FilterPopover must close on outside press")
assert(listSource:find("<ScrollArea", 1, true), "Lists must render Prism ScrollArea")
assert(listSource:find("<Stack", 1, true) or listSource:find("<Pressable", 1, true), "Lists must render Stack or Pressable rows")
assert(islandSource:find("TODO(prism-window)", 1, true), "The island entry must leave a Prism Window swap hook")
assert(windowSource:find("TODO(prism-window)", 1, true), "window.lua must stay a temporary host with a Prism Window TODO")
assert(not islandSource:find("function AppShell", 1, true), "Do not invent a Hydroxide AppShell")
assert(not islandSource:find("HydroxideAppShell", 1, true), "Do not invent a Hydroxide AppShell")
assert(not islandSource:find("<Draggable", 1, true), "Do not compose Draggable+Box chrome")
assert(not islandSource:find("from \"@prism/components/Draggable\"", 1, true), "Do not compose Draggable+Box chrome")
assert(not querySource:find("gethui", 1, true), "Prism islands must not call gethui")
assert(not indexSource:find("gethui", 1, true), "The mount entry must not call gethui")
assert(not fs.isFile("scripts/build_menu.cjs"), "Do not copy the hub Wax builder")
assert(not fs.isFile("ui/src/prismCompat.tsx"), "Do not shim Prism through a Hydroxide compat barrel")
assert(not fs.isFile("ui/tsconfig.prism.json"), "Do not generate a second tsconfig that copies Prism src")
assert(packageSource:find('"build": "rbxtsc"', 1, true), "ui npm build must be rbxtsc")
assert(packageSource:find('"prebuild": "node ../scripts/build_prism_dep.cjs"', 1, true), "rbxtsc must compile against the installed prism package")
assert(
	packageSource:find('"prism": "github:3xjn/prism"', 1, true) or packageSource:find('"prism": "file:../prism"', 1, true),
	"Prism must be a real package dependency (github:3xjn/prism or file:../prism)"
)
assert(tsconfig:find('"outDir": "out"', 1, true), "rbxtsc must emit ui/out")
assert(tsconfig:find('"@prism"', 1, true), "tsconfig must map Prism's @prism paths")
assert(tsconfig:find("node_modules/prism/out/lib", 1, true) or tsconfig:find(".prism/out/lib", 1, true), "tsconfig must consume the compiled prism package, not a copied src tree")
assert(not tsconfig:find(".generated/prism-src", 1, true), "Do not copy Prism src into .generated")
assert(not tsconfig:find("C:/git/prism", 1, true), "Do not hardcode a Prism checkout path")
assert(projectSource:find('"$path": "out"', 1, true), "Rojo must mount the rbxtsc ui/out artifact")
assert(waxSource:find("ui/default.project.json", 1, true) or waxSource:find("projectPath", 1, true), "Optional Wax must use Hydroxide's default.project.json")
assert(waxSource:find("wrapPerformWorkWithCoroutine", 1, true), "Executor Wax patches must stay tiny and in Hydroxide")
assert(not waxSource:find("C:/git/prism", 1, true), "Wax must not hardcode a Prism checkout path")
assert(not waxSource:find("prism-src", 1, true), "Wax must not copy Prism src into a generated tree")
assert(buildUiSource:find("npm run build", 1, true), "build_ui.sh must invoke the UI package rbxtsc build")
assert(gitignore:find("ui/node_modules/", 1, true), "UI node_modules must stay out of git")
assert(gitignore:find("ui/out/", 1, true), "rbxtsc emit must stay out of git")
assert(gitignore:find("ui/.prism", 1, true), "The local Prism package link must stay out of git")
assert(not fs.isDir("ui/.generated/prism-src"), "Generated Prism copies must not be vendored")
assert(prismSource:find('import("ui/dist/Hydroxide")', 1, true), "Runtime must load the optional Wax artifact")
assert(prismSource:find("mountHydroxide", 1, true), "Runtime must call mountHydroxide")
assert(queryBarSource:find('kind = "queryBar"', 1, true), "QueryBar.lua must mount a Prism query island")
assert(filterControlSource:find("QueryBar.new", 1, true), "FilterPopover.lua must reuse the Prism query island")
assert(listControlSource:find('kind = "list"', 1, true), "List.lua must mount a Prism list island")
assert(runtimeSource:find('query:SetAttribute("Placeholder"', 1, true), "Runtime query bars must be empty Prism hosts")
assert(not runtimeSource:find('create("TextBox", "Search"', 1, true), "Runtime must not hand-build query TextBoxes")
assert(not runtimeSource:find('create("ScrollingFrame", "Content"', 1, true), "Runtime must not hand-build list ScrollingFrames")
assert(checkSource:find("prism_pipeline_contracts.luau", 1, true), "check.sh must cover the Prism pipeline")
assert(explorerSource:find("return Explorer", 1, true), "Explorer must stay stubbed")
assert(not explorerSource:find("List.new", 1, true), "Explorer must not grow a page in this pass")
assert(mainSource:find("ScriptGraph = import(\"modules/ScriptGraph\")", 1, true), "ScriptGraph methods must stay on oh.Api")
assert(mainSource:find('import("ui/window")', 1, true), "The Luau window host must remain until Prism Window merges")
assert(not fs.isFile("modules/Drawing.lua"), "Drawing must stay deleted")
assert(fs.isFile("ui/dist/Hydroxide.lua"), "The optional Wax artifact must live at ui/dist/Hydroxide.lua")
assert(fs.isFile("ui/dist/Hydroxide.provenance"), "The Wax artifact must record Prism provenance")

local dist = fs.readFile("ui/dist/Hydroxide.lua")
local provenance = fs.readFile("ui/dist/Hydroxide.provenance")
assert(dist:find("mountHydroxide", 1, true), "The Wax bundle must export mountHydroxide")
assert(not dist:find("gethui()", 1, true) or provenance:find("mount_parent=host", 1, true), "The host owns the parent Instance")
assert(not dist:find(".generated/prism-src", 1, true), "The bundle must not include a copied Prism src tree")
assert(provenance:find("artifact=ui/dist/Hydroxide.lua", 1, true), "Provenance must name the Hydroxide artifact")
assert(provenance:find("prism_repository=https://github.com/3xjn/prism", 1, true), "Provenance must pin the Prism repository")
assert(provenance:find("bundler_version=0.4.2", 1, true), "Provenance must pin Wax 0.4.2")
assert(not fs.isDir("ui/.generated/prism"), "Prism source must not be vendored as a permanent tree")

print("prism-pipeline-contracts-ok")
