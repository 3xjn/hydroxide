local fs = require("@lune/fs")

local prismSource = fs.readFile("ui/prism.lua")
local queryBarSource = fs.readFile("ui/controls/QueryBar.lua")
local filterControlSource = fs.readFile("ui/controls/FilterPopover.lua")
local listControlSource = fs.readFile("ui/controls/List.lua")
local mainSource = fs.readFile("ui/main.lua")
local runtimeSource = fs.readFile("ui/runtime.lua")

assert(not fs.isFile("scripts/wax_ui.cjs"), "Do not bring back the Wax Lua patcher")
assert(not fs.isFile("scripts/build_menu.cjs"), "Do not bring back the hub Wax builder")
assert(not prismSource:find("gsub", 1, true), "Do not regex-patch a Wax blob at runtime")
assert(queryBarSource:find("Prism.mount(host", 1, true), "QueryBar must mount Prism on the GitHub path")
assert(not queryBarSource:find("Prism.available()", 1, true), "QueryBar must not skip Prism when the blob is shipped")

assert(not prismSource:find("function Prism.available", 1, true), "Do not keep an artifact-absent gate")
assert(prismSource:find("mountHydroxide", 1, true), "The dist blob must export mountHydroxide")
assert(fs.isFile("ui/dist/Hydroxide.lua"), "GitHub import(ui/dist/Hydroxide) must not 404")
assert(queryBarSource:find("FocusLost", 1, true), "Luau QueryBar chrome may remain as unused local code")
assert(queryBarSource:find("MouseButton1Click", 1, true), "Luau QueryBar chrome may remain as unused local code")
assert(filterControlSource:find("FilterPopover", 1, true), "Luau FilterPopover chrome may remain as unused local code")
assert(filterControlSource:find("ShowRoblox", 1, true), "Luau FilterPopover must still know ShowRoblox")
assert(filterControlSource:find("ShowExecutor", 1, true), "Luau FilterPopover must still know ShowExecutor")
assert(listControlSource:find("CanvasSize", 1, true), "Luau list chrome may remain as unused local code")
assert(listControlSource:find("MouseButton1Click", 1, true), "Luau list chrome may remain as unused local code")
assert(mainSource:find("xpcall", 1, true), "Feature modules must still isolate load failures")
assert(not mainSource:find("Prism.available()", 1, true), "Window chrome must not fall back when the blob is shipped")
assert(not mainSource:find('import("ui/window")', 1, true), "The artifact-absent window.lua path is gone")
assert(not fs.isFile("ui/window.lua"), "Do not keep a Luau Window fallback")
assert(not runtimeSource:find('import("ui/out', 1, true), "Runtime must not fetch rbxtsc emit as instances")
assert(not queryBarSource:find('import("ui/out', 1, true), "QueryBar must not fetch rbxtsc emit as instances")
assert(not listControlSource:find('import("ui/out', 1, true), "List must not fetch rbxtsc emit as instances")

print("prism-fallback-contracts-ok")
