local fs = require("@lune/fs")

local prismSource = fs.readFile("ui/prism.lua")
local queryBarSource = fs.readFile("ui/controls/QueryBar.lua")
local filterControlSource = fs.readFile("ui/controls/FilterPopover.lua")
local listControlSource = fs.readFile("ui/controls/List.lua")
local mainSource = fs.readFile("ui/main.lua")
local runtimeSource = fs.readFile("ui/runtime.lua")

assert(not fs.isFile("scripts/wax_ui.cjs"), "Do not bring back the Wax Lua patcher")
assert(not fs.isFile("scripts/build_menu.cjs"), "Do not bring back the hub Wax builder")
assert(not prismSource:find("gsub", 1, true), "Do not regex-patch a Wax blob at runtime")
assert(not queryBarSource:find("Prism.mount(host", 1, true) or queryBarSource:find("Prism.available()", 1, true), "QueryBar Prism.mount must be optional")

assert(prismSource:find("resolved = true", 1, true), "A missing dist blob must be remembered so GitHub 404s are not retried")
assert(prismSource:find("mountHydroxide", 1, true), "A present dist blob must still export mountHydroxide")
assert(queryBarSource:find("FocusLost", 1, true), "Luau QueryBar must submit from Enter")
assert(queryBarSource:find("MouseButton1Click", 1, true), "Luau QueryBar must fire actions from the host button")
assert(filterControlSource:find("FilterPopover", 1, true), "Luau FilterPopover chrome must stay available without Prism")
assert(filterControlSource:find("ShowRoblox", 1, true), "Luau FilterPopover must toggle ShowRoblox")
assert(filterControlSource:find("ShowExecutor", 1, true), "Luau FilterPopover must toggle ShowExecutor")
assert(listControlSource:find("CanvasSize", 1, true), "Luau lists must keep ScrollingFrame canvas sizing")
assert(listControlSource:find("MouseButton1Click", 1, true), "Luau list rows must remain clickable without Prism")
assert(mainSource:find("xpcall", 1, true), "Feature modules must still isolate load failures")
assert(mainSource:find("Prism.available()", 1, true), "Window chrome must follow the same optional-artifact gate as QueryBar")
assert(mainSource:find('import("ui/window")', 1, true), "GitHub loadstring without a dist blob must keep the Luau window fallback")
assert(not runtimeSource:find('import("ui/out', 1, true), "Runtime must not fetch rbxtsc emit as instances")
assert(not queryBarSource:find('import("ui/out', 1, true), "QueryBar must not fetch rbxtsc emit as instances")
assert(not listControlSource:find('import("ui/out', 1, true), "List must not fetch rbxtsc emit as instances")

print("prism-fallback-contracts-ok")
