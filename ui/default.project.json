{
	"name": "hydroxide-ui",
	"tree": {
		"$className": "ModuleScript",
		"$properties": {
			"Source": "return require(script.ReplicatedStorage.HydroxideUi)\n"
		},
		"ReplicatedStorage": {
			"$className": "Folder",
			"HydroxideUi": {
				"$path": "out"
			},
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@rbxts-js": {
						"$path": "node_modules/@rbxts-js"
					},
					"@3xjn": {
						"$path": "node_modules/@3xjn"
					}
				}
			}
		}
	}
}
